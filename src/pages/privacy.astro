---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Privacy: Noa Saitoshii"
  description="A plain-language privacy note for the Noa Saitoshii website."
>
  <article class="privacy-page page-shell">
    <h1>Privacy</h1>
    <div class="privacy-page__copy">
      <p>This is a static website hosted on Cloudflare.</p>
      <p>The site does not set cookies of its own, and it does not use analytics yet.</p>
      <p>When you click to watch a live stream, the Twitch player loads. Twitch may set its own cookies and handle information under its own policies.</p>
      <p>Questions are welcome at <a href="mailto:contact@saitoshii.com">contact@saitoshii.com</a>.</p>
    </div>
  </article>
</BaseLayout>
