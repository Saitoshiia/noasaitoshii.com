---
const links = [
  ['/events', 'Events'],
  ['/#listen', 'Listen'],
  ['/#about', 'About'],
  ['/#links', 'Links'],
  ['/#contact', 'Contact'],
]
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="brand" href="/" aria-label="Noa Saitoshii home">
      <img src="/favicon.svg" alt="" width="28" height="28" />
    </a>
    <nav aria-label="Main navigation">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="header-live" href="https://www.twitch.tv/noasaitoshii" target="_blank" rel="noreferrer">
      <span class="status-dot" data-header-dot></span>
      <span data-header-status>Twitch</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header')
  if (header) {
    const syncHeaderOffset = () => {
      document.documentElement.style.setProperty('--site-header-offset', `${header.getBoundingClientRect().height}px`)
    }

    syncHeaderOffset()
    new ResizeObserver(syncHeaderOffset).observe(header)
  }
</script>
